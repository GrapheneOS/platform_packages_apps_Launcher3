<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:key="preference_screen"
    android:persistent="false" >
    <com.android.launcher3.settings.NotificationDotsPreference
        android:key="pref_icon_badging"
        android:persistent="false"
        android:title="@string/notification_dots_title"
        android:widgetLayout="@layout/notification_pref_warning" />
    <SwitchPreference
        xmlns:launcher="http://schemas.android.com/apk/res-auto"
        android:defaultValue="@bool/pref_add_icon_to_home_default"
        android:key="pref_add_icon_to_home"
        android:persistent="true"
        android:summary="@string/auto_add_shortcuts_description"
        android:title="@string/auto_add_shortcuts_label"
        launcher:logIdOff="614"
        launcher:logIdOn="613" />
    <PreferenceScreen
        android:key="app_list_settings"
        android:persistent="true"
        android:summary="@string/app_list_pref_screen_desc"
        android:title="@string/app_list_pref_screen_title" >
        <SwitchPreference
            android:defaultValue="@bool/apps_list_pref_two_lines_toggle"
            android:key="pref_enable_two_line_toggle"
            android:persistent="true"
            android:summary="@string/app_list_pref_screen_enable_two_line_summary"
            android:title="@string/app_list_pref_screen_enable_two_line_title" />
    </PreferenceScreen>
    <PreferenceScreen
        android:key="pref_developer_options"
        android:persistent="false"
        android:title="Developer Options" >
        <com.android.launcher3.uioverrides.flags.DevOptionsUiHelper
            android:key="pref_developer_options"
            android:persistent="false" />
    </PreferenceScreen>
    <SwitchPreference
        xmlns:launcher="http://schemas.android.com/apk/res-auto"
        android:defaultValue="false"
        android:key="pref_fixed_landscape_mode"
        android:summary="@string/landscape_mode_desc"
        android:title="@string/landscape_mode_title"
        launcher:logIdOff="2020"
        launcher:logIdOn="2014" />
</PreferenceScreen>
