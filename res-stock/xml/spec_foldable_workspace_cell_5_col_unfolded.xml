<?xml version="1.0" encoding="utf-8"?>
<cellSpecs>
    <specs
        xmlns:launcher="http://schemas.android.com/apk/res-auto"
        launcher:maxAspectRatio="@dimen/aspect_ratio_portrait_and_square" >
        <cellSpec
            launcher:dimensionType="height"
            launcher:maxAvailableSize="9999.0dp" >
            <iconDrawablePadding launcher:fixedSize="4.0dp" />
            <iconSize launcher:fixedSize="@dimen/iconSize48dp" />
            <iconTextSize launcher:fixedSize="12.0sp" />
        </cellSpec>
    </specs>
    <specs
        xmlns:launcher="http://schemas.android.com/apk/res-auto"
        launcher:maxAspectRatio="@dimen/aspect_ratio_landscape" >
        <cellSpec
            launcher:dimensionType="height"
            launcher:maxAvailableSize="9999.0dp" >
            <iconDrawablePadding launcher:fixedSize="4.0dp" />
            <iconSize launcher:fixedSize="@dimen/iconSize58dp" />
            <iconTextSize launcher:fixedSize="12.0sp" />
        </cellSpec>
    </specs>
</cellSpecs>
