<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/private_space_search_result"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ps_header_height"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/ps_header_layout_margin"
    android:screenReaderFocusable="true">

    <ImageView
        android:layout_width="@dimen/ps_header_image_height"
        android:layout_height="@dimen/ps_header_image_height"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_private_space_with_background" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ps_header_layout_margin"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/private_space_label"
            android:textColor="@color/materialColorOnSurface"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/private_space_secondary_label"
            android:textColor="@color/materialColorOnSurfaceVariant"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
