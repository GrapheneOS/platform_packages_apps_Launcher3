<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:id="@+id/quickspace_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="44dp"
    android:layout_gravity="start|top" >

    <!-- Day of the Week -->
    <TextView
        android:id="@+id/quickspace_day_of_week"
        android:fontFamily="google-sans-medium"
        android:paddingStart="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?workspaceTextColor"
        android:textSize="28sp"
        android:textStyle="normal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Clock -->
    <com.android.launcher3.quickspace.views.AccentedTextClock
        android:id="@+id/quickspace_clock"
        android:paddingStart="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="google-sans-flex"
        android:textColor="?workspaceTextColor"
        android:textSize="80sp"
        android:format12Hour="h:mm"
        android:format24Hour="H:mm"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/quickspace_day_of_week" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/date_weather_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="quickspace_date,quick_event_weather_content" />

    <!-- Date -->
    <TextView
        android:id="@+id/quickspace_date"
        style="@style/QuickSpaceSubText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:fontFamily="google-sans-flex"
        android:textColor="?workspaceTextColor"
        android:textSize="@dimen/quickspace_subtitle_size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/quickspace_clock" />

    <include
        android:id="@+id/quick_event_weather_content"
        layout="@layout/quickspace_weather_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/quickspace_date"
        app:layout_constraintTop_toBottomOf="@id/quickspace_clock" />

    <!-- Contextual Info (PSA or Now Playing) -->
    <FrameLayout
        android:id="@+id/contextual_info_row"
        android:paddingStart="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/date_weather_barrier">
        
        <!-- Now Playing -->
        <LinearLayout
            android:id="@+id/now_playing_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">
            <ImageView
                android:id="@+id/now_playing_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_music_note_24dp"
                android:tint="?workspaceTextColor"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:id="@+id/now_playing_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?workspaceTextColor"
                android:fontFamily="google-sans-flex"
                android:textSize="@dimen/quickspace_subtitle_size"
                android:singleLine="true"/>
        </LinearLayout>

        <!-- PSA Message -->
        <TextView
            android:id="@+id/quickspace_psa_message"
            style="@style/QuickSpaceSubText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?workspaceTextColor"
            android:fontFamily="google-sans-flex"
            android:textSize="@dimen/quickspace_subtitle_size"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Battery Pill -->
    <FrameLayout
        android:id="@+id/battery_info_row"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        android:background="@drawable/bg_battery_pill"
        android:clipChildren="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contextual_info_row">

        <!-- Progress Bar Fill -->
        <FrameLayout
            android:id="@+id/battery_progress_bar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:clipToOutline="true"
            android:background="@drawable/bg_battery_progress">
            <View
                android:id="@+id/battery_shimmer_view"
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_battery_shimmer"
                android:visibility="gone"/>
        </FrameLayout>

        <!-- Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/battery_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_battery_std"
                    android:tint="?workspaceTextColor"
                    android:alpha="0.6"/>

                <ImageView
                    android:id="@+id/battery_charging_overlay"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="bottom|end"
                    android:elevation="1dp"
                    android:src="@drawable/ic_bolt_mini"
                    android:tint="?workspaceTextColor"
                    android:alpha="0.8"
                    android:visibility="gone"/>
            </FrameLayout>

            <TextView
                android:id="@+id/battery_device_name"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="?workspaceTextColor"
                android:textSize="16sp"
                android:fontFamily="google-sans-medium"
                android:ellipsize="end"
                android:singleLine="true" />

            <TextView
                android:id="@+id/battery_percentage"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="@drawable/bg_battery_level_tag"
                android:textColor="?android:attr/textColorPrimaryInverse"
                android:textSize="12sp"
                android:fontFamily="google-sans-medium"
                android:singleLine="true"/>

            <!-- Dots Indicator -->
            <LinearLayout
                android:id="@+id/battery_dots_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="8dp"
                android:gravity="center_vertical" />

        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
