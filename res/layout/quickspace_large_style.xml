<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:id="@+id/quickspace_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="start|center_vertical">

    <!-- Day of the Week -->
    <com.android.launcher3.quickspace.views.DoubleShadowTextView
        android:id="@+id/quickspace_day_of_week"
        android:fontFamily="sans-serif-condensed-medium"
        android:paddingStart="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?workspaceTextColor"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        launcher:ambientShadowBlur="3dp"
        launcher:ambientShadowColor="?workspaceAmbientShadowColor"
        launcher:keyShadowBlur="2dp"
        launcher:keyShadowColor="?workspaceKeyShadowColor"
        launcher:keyShadowOffsetX="0.5dip" />

    <!-- Clock -->
    <com.android.launcher3.quickspace.views.AccentedTextClock
        android:id="@+id/quickspace_clock"
        android:paddingStart="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="?workspaceTextColor"
        android:textSize="80sp"
        android:format12Hour="h:mm"
        android:format24Hour="H:mm"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/quickspace_day_of_week" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/date_weather_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="quickspace_date,quick_event_weather_content" />

    <com.android.launcher3.quickspace.views.DoubleShadowTextView
        android:id="@+id/quickspace_date"
        style="@style/QuickSpaceSubText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:textColor="?workspaceTextColor"
        android:textSize="@dimen/quickspace_subtitle_size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/quickspace_clock"
        launcher:ambientShadowBlur="3dp"
        launcher:ambientShadowColor="?workspaceAmbientShadowColor"
        launcher:keyShadowBlur="2dp"
        launcher:keyShadowColor="?workspaceKeyShadowColor"
        launcher:keyShadowOffsetX="0.5dip" />

    <include
        android:id="@+id/quick_event_weather_content"
        layout="@layout/quickspace_weather_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/quickspace_date"
        app:layout_constraintTop_toBottomOf="@id/quickspace_clock" />

    <!-- Contextual Info (PSA or Now Playing) -->
    <FrameLayout
        android:id="@+id/contextual_info_row"
        android:paddingStart="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/date_weather_barrier">
        
        <!-- Now Playing -->
        <LinearLayout
            android:id="@+id/now_playing_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">
            <ImageView
                android:id="@+id/now_playing_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_music_note_24dp"
                android:tint="?workspaceTextColor"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:id="@+id/now_playing_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?workspaceTextColor"
                android:textSize="@dimen/quickspace_subtitle_size"
                android:singleLine="true"/>
        </LinearLayout>

        <!-- PSA Message -->
        <com.android.launcher3.quickspace.views.DoubleShadowTextView
            android:id="@+id/quickspace_psa_message"
            style="@style/QuickSpaceSubText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?workspaceTextColor"
            android:textSize="@dimen/quickspace_subtitle_size"
            android:visibility="gone"
            launcher:ambientShadowBlur="3dp"
            launcher:ambientShadowColor="?workspaceAmbientShadowColor"
            launcher:keyShadowBlur="2dp"
            launcher:keyShadowColor="?workspaceKeyShadowColor"
            launcher:keyShadowOffsetX="0.5dip" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
